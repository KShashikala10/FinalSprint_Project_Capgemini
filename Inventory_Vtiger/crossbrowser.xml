<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Vtiger Cross Browser Suite"
       parallel="tests"
       thread-count="3">

    <test name="Chrome Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="PurchaseOrder.PurchaseOrderTest"/>
            <class name="PriceBooks.PriceBooksPositiveTest"/>
            <class name="PriceBooks.PriceBooksNegativeTest"/>
            <class name="Service.ServicesTest"/>
            <class name="Vendor.VendorsTest"/>
            <class name="Assests.AssestsTest"/>
            <class name="Login.PositiveLoginTest"/>
            <class name="Login.NegativeLoginTest"/>
        </classes>
    </test>

    <test name="Firefox Tests">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="PurchaseOrder.PurchaseOrderTest"/>
            <class name="PriceBooks.PriceBooksPositiveTest"/>
            <class name="PriceBooks.PriceBooksNegativeTest"/>
            <class name="Service.ServicesTest"/>
            <class name="Vendor.VendorsTest"/>
            <class name="Assests.AssestsTest"/>
            <class name="Login.PositiveLoginTest"/>
            <class name="Login.NegativeLoginTest"/>
        </classes>
    </test>

    <test name="Edge Tests">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="PurchaseOrder.PurchaseOrderTest"/>
            <class name="PriceBooks.PriceBooksPositiveTest"/>
            <class name="PriceBooks.PriceBooksNegativeTest"/>
            <class name="Service.ServicesTest"/>
            <class name="Vendor.VendorsTest"/>
            <class name="Assests.AssestsTest"/>
            <class name="Login.PositiveLoginTest"/>
            <class name="Login.NegativeLoginTest"/>
        </classes>
    </test>

</suite>
